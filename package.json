{
  "name": "everwell-dental-static",
  "version": "1.0.0",
  "private": true,
  "description": "Everwell Dental static prototype (Tailwind CSS v4)",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --watch",
    "build": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --minify",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
